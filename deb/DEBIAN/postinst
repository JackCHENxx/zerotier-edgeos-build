#!/bin/sh
set -e

ZT_ROOT=/config/zerotier-one
chmod 755 "$ZT_ROOT/zerotier-one" "$ZT_ROOT/lib64/ld.so.1" 2>/dev/null || true
chmod 755 "$ZT_ROOT/bin/"* 2>/dev/null || true

# Official entry points in /usr/sbin, so plain `zerotier-cli info` works.
link_sbin() {
    for t in zerotier-one zerotier-cli zerotier-idtool; do
        dst="/usr/sbin/$t"
        # keep whatever was there before (e.g. an official 1.8.4 binary)
        if [ -e "$dst" ] && [ ! -L "$dst" ] && [ ! -e "$dst.edgeos-orig" ]; then
            mv "$dst" "$dst.edgeos-orig" 2>/dev/null || true
        fi
        ln -sf "$ZT_ROOT/bin/$t" "$dst" 2>/dev/null || true
    done
}
link_sbin

mkdir -p /config/scripts/post-config.d
# Drop the hook left by the old short-name layout.
rm -f /config/scripts/post-config.d/zerotier-start.sh

cat > /config/scripts/post-config.d/zerotier-one-start.sh <<'EOS'
#!/bin/sh
ZT_ROOT=/config/zerotier-one
ZT_LD=$ZT_ROOT/lib64/ld.so.1
ZT_LIB=$ZT_ROOT/lib
ZT_BIN=$ZT_ROOT/zerotier-one
ZT_HOME=$ZT_ROOT/home
ZT_PORT=9993

# /usr may be reset by a firmware upgrade: recreate the official entry points.
for t in zerotier-one zerotier-cli zerotier-idtool; do
    ln -sf "$ZT_ROOT/bin/$t" "/usr/sbin/$t" 2>/dev/null || true
done

[ -x "$ZT_BIN" ] || exit 0
[ -x "$ZT_LD" ] || exit 0
if ps ax 2>/dev/null | grep -v grep | grep -q "zerotier-one -p$ZT_PORT"; then
    exit 0
fi
nohup "$ZT_LD" --library-path "$ZT_LIB" "$ZT_BIN" -p$ZT_PORT -d "$ZT_HOME" >/dev/null 2>&1 &
exit 0
EOS

chmod 755 /config/scripts/post-config.d/zerotier-one-start.sh

if ! ps ax 2>/dev/null | grep -v grep | grep -q "zerotier-one -p9993"; then
    nohup /config/zerotier-one/lib64/ld.so.1 --library-path /config/zerotier-one/lib \
        /config/zerotier-one/zerotier-one -p9993 -d /config/zerotier-one/home >/dev/null 2>&1 &
fi

exit 0

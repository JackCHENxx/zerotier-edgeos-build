#!/bin/sh
pkill -f "zerotier-one -p9993" >/dev/null 2>&1 || true
for t in zerotier-one zerotier-cli zerotier-idtool; do
    [ "$(readlink "/usr/sbin/$t" 2>/dev/null)" = "/config/zerotier-one/bin/$t" ] && rm -f "/usr/sbin/$t"
done
rm -f /config/scripts/post-config.d/zerotier-one-start.sh
rm -f /config/scripts/post-config.d/zerotier-start.sh
exit 0
